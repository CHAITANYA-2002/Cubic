# ---------------------------------------------------------------
# Contact form (static deploy — Vercel / Netlify)
# ---------------------------------------------------------------
# Free access key from https://web3forms.com (enter your email, no signup).
# Every submission is emailed to the address the key is registered to.
# Set this in the host's Environment Variables UI, then redeploy.
VITE_WEB3FORMS_KEY=

# ---------------------------------------------------------------
# Only needed if running the Express backend (npm run dev / a Node host)
# ---------------------------------------------------------------
# Postgres connection string. If unset, leads are kept in memory only.
DATABASE_URL=

# Admin panel password (/admin). Always override this on a public server.
ADMIN_PASSWORD=

# Opaque session token returned after admin login.
ADMIN_TOKEN=
